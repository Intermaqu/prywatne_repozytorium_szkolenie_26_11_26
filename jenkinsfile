pipeline {
    // Budowanie na dowlnym agencie
    agent any
    // Stages

    parameters {
      string defaultValue: 'Pattaya', name: 'CITY', trim: true
    }

    stages {
        stage('Pogoda') {
            steps {

                checkout scmGit(
                  branches: [[name: '*/main']], 
                  extensions: [], 
                  userRemoteConfigs: [[
                    credentialsId: 'klucz-github-priv', 
                    url: 'https://github.com/Intermaqu/prywatne_repozytorium_szkolenie_26_11_26'
                  ]]
                )

                script {
                    sh '''
                        echo $CITY
                        echo $params.CITY
                        echo $WEATHER_API_KEY
                        chmod +x ./start.sh
                        ./start.sh $CITY $WEATHER_API_KEY}
                    '''
                }
            }
        }
    }
    post {
      always {
        cleanWs()
      }
    }
}

